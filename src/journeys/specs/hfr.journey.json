{
  "$comment": "HFR (Health Facility Registry) journey: register a facility with ABDM — Basic Information (the draft), Additional and Detailed Information (required while the facility is Functional: HFR refuses submit otherwise, live 2026-10-02), then Submit. An account can register many facilities (hfrFacilities.js); every visit with any facility on this device starts at `facilities`: submitted ones can be viewed (read-only) or updated (a section sent again with the facility id in place of the tracking id, New_HFR_APIs_Documentation_SBX §2), a draft resumes at the first section HFR doesn't have yet (its `stage`), or a new facility is registered. Basic Information and Submit need the Facility Manager's HPR token (x-hprid-auth), reused from Cübo's profile when this session already signed in. Steps and transitions are here; gateway calls and prompts are the named handlers in hfrJourney.js. Run by engine.js on XState.",
  "id": "hfr",
  "title": "HFR facility",
  "summary": "Register your facility with the Health Facility Registry",
  "icon": "fa-hospital",
  "related": [
    {
      "label": "Facility profile",
      "to": "/onboarding",
      "icon": "fa-building",
      "note": "Your clinic's own record — independent of what is registered with HFR"
    }
  ],
  "start": "begin",
  "steps": {
    "begin": {
      "type": "auto",
      "run": "loadSaved",
      "next": [
        {
          "if": "data.hasFacilities",
          "to": "facilities"
        },
        {
          "if": "data.hasHpr",
          "to": "loadBasics"
        },
        {
          "to": "managerLogin"
        }
      ]
    },
    "facilities": {
      "type": "ask",
      "prompt": "facilities",
      "run": "chooseFacility",
      "next": [
        {
          "if": "data.pick == 'update'",
          "to": "updateWhat"
        },
        {
          "if": "data.pick == 'view'",
          "to": "view"
        },
        {
          "if": "data.pick == 'continue' && data.stage == 'detailed' && data.hasHpr",
          "to": "submit"
        },
        {
          "if": "data.pick == 'continue' && data.stage == 'detailed'",
          "to": "managerLogin"
        },
        {
          "if": "data.pick == 'continue'",
          "to": "loadDetails"
        },
        {
          "if": "data.hasHpr",
          "to": "loadBasics"
        },
        {
          "to": "managerLogin"
        }
      ]
    },
    "view": {
      "type": "final",
      "run": "viewFacility"
    },
    "updateWhat": {
      "type": "ask",
      "prompt": "updateWhat",
      "run": "chooseUpdate",
      "next": [
        {
          "if": "data.section == 'basic' && data.hasHpr",
          "to": "loadBasics"
        },
        {
          "if": "data.section == 'basic'",
          "to": "managerLogin"
        },
        {
          "to": "loadDetails"
        }
      ],
      "ledger": {
        "label": "What to update",
        "stage": "Update"
      }
    },
    "managerLogin": {
      "type": "ask",
      "signIn": "hpr",
      "prompt": "managerLogin",
      "run": "managerLogin",
      "next": [
        {
          "if": "data.updating",
          "to": "loadBasics"
        },
        {
          "if": "data.trackingId",
          "to": "submit"
        },
        {
          "to": "loadBasics"
        }
      ],
      "ledger": {
        "label": "Facility manager's HPR sign-in",
        "stage": "Basic information"
      }
    },
    "loadBasics": {
      "type": "auto",
      "run": "loadBasics",
      "next": "facility"
    },
    "facility": {
      "type": "ask",
      "revisit": true,
      "prompt": "facility",
      "run": "describeFacility",
      "next": "loadDependent",
      "ledger": {
        "label": "Facility",
        "stage": "Basic information"
      }
    },
    "loadDependent": {
      "type": "auto",
      "run": "loadDependent",
      "next": "classify"
    },
    "classify": {
      "type": "ask",
      "revisit": true,
      "prompt": "classify",
      "run": "classifyFacility",
      "next": "loadLocation",
      "ledger": {
        "label": "Ownership and type",
        "stage": "Basic information"
      }
    },
    "loadLocation": {
      "type": "auto",
      "run": "loadLocation",
      "next": "location"
    },
    "location": {
      "type": "ask",
      "revisit": true,
      "prompt": "location",
      "run": "locateFacility",
      "next": "hours",
      "ledger": {
        "label": "Location",
        "stage": "Basic information"
      }
    },
    "hours": {
      "type": "ask",
      "revisit": true,
      "prompt": "hours",
      "run": "describeHours",
      "next": "review",
      "ledger": {
        "label": "Hours and photos",
        "stage": "Basic information"
      }
    },
    "review": {
      "type": "ask",
      "revisit": true,
      "prompt": "review",
      "run": "saveDraft",
      "next": [
        {
          "if": "data.stopped",
          "to": "done"
        },
        {
          "if": "data.updated",
          "to": "done"
        },
        {
          "to": "loadDetails"
        }
      ],
      "ledger": {
        "label": "Review and save draft",
        "stage": "Basic information"
      }
    },
    "loadDetails": {
      "type": "auto",
      "run": "loadDetails",
      "next": [
        {
          "if": "data.section == 'detailed'",
          "to": "detailed"
        },
        {
          "if": "data.section == 'additional'",
          "to": "additional"
        },
        {
          "if": "data.stage == 'additional'",
          "to": "detailed"
        },
        {
          "to": "additional"
        }
      ]
    },
    "additional": {
      "type": "ask",
      "revisit": true,
      "prompt": "additional",
      "run": "saveAdditional",
      "next": [
        {
          "if": "data.updated",
          "to": "done"
        },
        {
          "to": "detailed"
        }
      ],
      "ledger": {
        "label": "Programmes and services",
        "stage": "Additional information"
      }
    },
    "detailed": {
      "type": "ask",
      "revisit": true,
      "prompt": "detailed",
      "run": "saveDetailed",
      "next": [
        {
          "if": "data.updated",
          "to": "done"
        },
        {
          "to": "checkSignIn"
        }
      ],
      "ledger": {
        "label": "Specialities and beds",
        "stage": "Detailed information"
      }
    },
    "checkSignIn": {
      "type": "auto",
      "run": "checkSignIn",
      "next": [
        {
          "if": "data.hasHpr",
          "to": "submit"
        },
        {
          "to": "managerLogin"
        }
      ]
    },
    "submit": {
      "type": "ask",
      "prompt": "submit",
      "run": "submitToHfr",
      "next": "done",
      "ledger": {
        "label": "Submit to HFR",
        "stage": "Submit"
      }
    },
    "done": {
      "type": "final",
      "run": "result"
    }
  }
}
