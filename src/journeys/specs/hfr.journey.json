{
  "$comment": "HFR (Health Facility Registry) journey: register a facility with ABDM — Basic Information (the draft), Additional and Detailed Information (required while the facility is Functional: HFR refuses submit otherwise, live 2026-10-02), then Submit. An account can register many facilities (hfrFacilities.js); every visit with any facility on this device starts at `facilities`: submitted ones can only be viewed (read-only), a draft resumes at the first section HFR doesn't have yet (its `stage`), or a new facility is registered. Basic Information and Submit need the Facility Manager's HPR token (x-hprid-auth), reused from Cübo's profile when this session already signed in. Steps and transitions are here; gateway calls and prompts are the named handlers in hfrJourney.js. Run by engine.js on XState.",
  "id": "hfr",
  "title": "HFR facility",
  "summary": "Register your facility with the Health Facility Registry",
  "icon": "fa-hospital",
  "related": [{"label": "Facility profile", "to": "/onboarding", "icon": "fa-building", "note": "Your clinic's own record — independent of what is registered with HFR"}],
  "start": "begin",
  "steps": {
    "begin":         {"type": "auto", "run": "loadSaved", "next": [{"if": "data.hasFacilities", "to": "facilities"}, {"if": "data.hasHpr", "to": "loadBasics"}, {"to": "managerLogin"}]},
    "facilities":    {"type": "ask", "prompt": "facilities", "run": "chooseFacility", "next": [{"if": "data.pick == 'view'", "to": "view"}, {"if": "data.pick == 'continue' && data.stage == 'detailed' && data.hasHpr", "to": "submit"}, {"if": "data.pick == 'continue' && data.stage == 'detailed'", "to": "managerLogin"}, {"if": "data.pick == 'continue'", "to": "loadDetails"}, {"if": "data.hasHpr", "to": "loadBasics"}, {"to": "managerLogin"}]},
    "view":          {"type": "final", "run": "viewFacility"},
    "managerLogin":  {"type": "ask", "signIn": "hpr", "prompt": "managerLogin", "run": "managerLogin", "next": [{"if": "data.trackingId", "to": "submit"}, {"to": "loadBasics"}], "ledger": {"label": "Facility manager's HPR sign-in"}},
    "loadBasics":    {"type": "auto", "run": "loadBasics", "next": "facility"},
    "facility":      {"type": "ask", "revisit": true, "prompt": "facility", "run": "describeFacility", "next": "loadDependent", "ledger": {"label": "Facility"}},
    "loadDependent": {"type": "auto", "run": "loadDependent", "next": "classify"},
    "classify":      {"type": "ask", "revisit": true, "prompt": "classify", "run": "classifyFacility", "next": "loadLocation", "ledger": {"label": "Ownership and type"}},
    "loadLocation":  {"type": "auto", "run": "loadLocation", "next": "location"},
    "location":      {"type": "ask", "revisit": true, "prompt": "location", "run": "locateFacility", "next": "hours", "ledger": {"label": "Location"}},
    "hours":         {"type": "ask", "revisit": true, "prompt": "hours", "run": "describeHours", "next": "review", "ledger": {"label": "Hours and photos"}},
    "review":        {"type": "ask", "revisit": true, "prompt": "review", "run": "saveDraft", "next": [{"if": "data.stopped", "to": "done"}, {"to": "loadDetails"}], "ledger": {"label": "Review and save draft"}},
    "loadDetails":   {"type": "auto", "run": "loadDetails", "next": [{"if": "data.stage == 'additional'", "to": "detailed"}, {"to": "additional"}]},
    "additional":    {"type": "ask", "revisit": true, "prompt": "additional", "run": "saveAdditional", "next": "detailed", "ledger": {"label": "Programmes and services"}},
    "detailed":      {"type": "ask", "revisit": true, "prompt": "detailed", "run": "saveDetailed", "next": "checkSignIn", "ledger": {"label": "Specialities and beds"}},
    "checkSignIn":   {"type": "auto", "run": "checkSignIn", "next": [{"if": "data.hasHpr", "to": "submit"}, {"to": "managerLogin"}]},
    "submit":        {"type": "ask", "prompt": "submit", "run": "submitToHfr", "next": "done", "ledger": {"label": "Submit to HFR"}},
    "done":          {"type": "final", "run": "result"}
  }
}
