# Copy to .env.local for local dev. clinuxflow-api is the Hono/Workers backend this frontend
# calls for forms/scribe/clinic-specialities; run it locally with `wrangler dev` (default port
# 8787) or point this at its deployed *.workers.dev URL.
VITE_API_BASE=http://localhost:8787

# clinuxflow-abdm-gateway — used by AbdmOnboarding.vue. Point at the deployed gateway's
# *.workers.dev URL for production builds.
VITE_ABDM_GATEWAY_BASE=http://localhost:8788

# Shared secret both backends require as X-Service-Key (see their own SERVICE_KEY secret +
# src/index.js auth middleware). Must match exactly for local dev; production builds use the
# real value, injected at build time, never committed.
VITE_SERVICE_KEY=dev-local-shared-secret
